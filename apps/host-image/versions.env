# Pinned inputs of the DevChain host image. build.sh sources this file; any
# variable can be overridden from the environment for a one-off build.
# Bump a pin here, rebuild, and publish under a new image version.

# Ubuntu 24.04 minimal cloud image, pinned to a dated serial so the base never moves.
UBUNTU_SERIAL=20260905
UBUNTU_IMAGE_SHA256=46b0dbaffa6950a7da5ff2dc5ed34c46084610b3b6d1fae8f1ec2d7e953984a3

# Node.js from nodejs.org (verified against SHASUMS256.txt). DevChain requires Node 24.
NODE_VERSION=24.21.0

# Syncthing v2 from the official apt repository (apt.syncthing.net, stable-v2).
SYNCTHING_VERSION=2.1.5

# Space-separated apt names: runtime requirements and best-effort agent tools.
DEVCHAIN_REQUIRED_PACKAGES=qemu-guest-agent tmux git curl ca-certificates xz-utils build-essential python3 jq openssl procps
DEVCHAIN_TOOL_PACKAGES=ripgrep python-is-python3 python3-pip python3-venv file sqlite3 bsdextrautils rsync unzip screen psmisc time lsof strace htop less nano vim-tiny tree zip net-tools iputils-ping inetutils-telnet netcat-openbsd bind9-dnsutils traceroute mtr-tiny tcpdump socat fd-find universal-ctags gawk shellcheck cloc git-lfs

# ast-grep from npm (@ast-grep/cli); Ubuntu 24.04 has no package. Only new
# images get it: claim and Update VM install apt packages and provider CLIs only.
AST_GREP_VERSION=0.45.3

# Registry the bootstrap service installs devchain-cli from at claim time.
NPM_REGISTRY=https://registry.npmjs.org/

# Virtual disk size of the published image. cloud-init grows the root
# partition to the VM's disk at first boot, so a VM disk must be at least this.
DISK_SIZE=8G
