{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["pnpm-workspace.yaml"],
  "globalEnv": ["NODE_ENV", "CI", "TZ", "TMUX_INTEGRATION", "ORCHESTRATOR_DOCKER_TEST_IMAGE"],
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "outputLogs": "new-only",
      "cache": true
    },
    "test:external": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false
    }
  }
}
